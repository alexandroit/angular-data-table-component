{
  "name": "@stackline/angular-data-table-component",
  "version": "22.1.0",
  "description": "An Angular 22 data table with sorting, filtering, pagination, selection, grouping, pinning, virtualization, templates, and a headless controller.",
  "keywords": [
    "angular",
    "angular22",
    "angular-library",
    "typescript",
    "data-table",
    "datatable",
    "table",
    "grid",
    "sorting",
    "filtering",
    "pagination",
    "selection",
    "grouping",
    "column-pinning",
    "row-pinning",
    "virtualization",
    "headless",
    "accessibility"
  ],
  "homepage": "https://alexandro.net/docs/angular/angular-data-table-component/angular-22/",
  "bugs": {
    "url": "https://github.com/alexandroit/angular-data-table-component/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexandroit/angular-data-table-component.git"
  },
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "sideEffects": false,
  "main": "./dist/fesm2022/stackline-angular-data-table-component.mjs",
  "module": "./dist/fesm2022/stackline-angular-data-table-component.mjs",
  "es2022": "./dist/fesm2022/stackline-angular-data-table-component.mjs",
  "fesm2022": "./dist/fesm2022/stackline-angular-data-table-component.mjs",
  "typings": "./dist/types/stackline-angular-data-table-component.d.ts",
  "types": "./dist/types/stackline-angular-data-table-component.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "test:fixtures": "node tools/stackline-run-release-smoke.mjs --catalog",
    "build": "ng-packagr -p ng-package.json && node scripts/finalize-package.mjs",
    "build:docs": "npm run build --prefix docs-src/angular-22",
    "docs:install": "npm install --ignore-scripts --prefix docs-src/angular-22",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pretest": "npm run build",
    "test": "node --test tests/*.test.cjs",
    "test:browser": "node scripts/verify-angular-22-docs.mjs",
    "test:consumer": "node scripts/consumer-smoke.mjs",
    "pack:check": "node scripts/pack-check.mjs",
    "check": "npm run typecheck && npm test && npm run pack:check",
    "verify": "npm run check && npm run test:consumer && npm run build:docs && npm run test:browser"
  },
  "peerDependencies": {
    "@angular/common": ">=22.0.0 <23.0.0",
    "@angular/core": ">=22.0.0 <23.0.0"
  },
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/common": "22.1.3",
    "@angular/compiler": "22.1.3",
    "@angular/compiler-cli": "22.1.3",
    "@angular/core": "22.1.3",
    "ng-packagr": "22.1.1",
    "puppeteer-core": "25.8.0",
    "typescript": "6.0.3"
  }
}
